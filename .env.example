# AIG Force — Environment Variables
# Copy this file to .env.local and fill in real values

# ═══ Supabase — stores enquiries, applications and résumé files ═══
# Project Settings → Data API  (the URL and the anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API Keys → service_role.
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never import it client-side.
SUPABASE_SERVICE_ROLE_KEY=

# ═══ Resend — notification email for new submissions ═══
# https://resend.com/api-keys
RESEND_API_KEY=
# Optional. Set once aigforce.co is verified in Resend:
# RESEND_FROM=AIG Force <careers@aigforce.co>

# ═══ Site ═══
NEXT_PUBLIC_SITE_URL=https://aigforce.co

# Google Tag Manager (Phase 1)
NEXT_PUBLIC_GTM_ID=
